{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "5s",
  "tags": ["ozone-oidc-proxy"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "title": "Ozone OIDC Proxy",
  "uid": "ozpx-overview",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Traffic",
      "description": "Total request rate across all lanes (request_duration_seconds count).",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "ozpx-prometheus" },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(rate(request_duration_seconds_count[1m]))",
          "legendFormat": "req/s",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "#3987e5" }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "SigV4 verification p99",
      "description": "p99 of the pure verification step, sigv4 lane (DESIGN.md §11.5 target: < 1 ms). Number turns red above the 1 ms SLO.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "ozpx-prometheus" },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(verification_duration_seconds_bucket{lane=\"sigv4\"}[5m])))",
          "legendFormat": "p99",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#d03b3b", "value": 0.001 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active credentials",
      "description": "Unexpired temporary credentials in the store (shared across replicas).",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "ozpx-prometheus" },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "max(active_credentials)",
          "legendFormat": "active",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "#9085e9" }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Revocations",
      "description": "Cumulative admin credential revocations (revocations_total, result=revoked).",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "ozpx-prometheus" },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(revocations_total{result=\"revoked\"})",
          "legendFormat": "revoked",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "color": { "mode": "fixed", "fixedColor": "#c98500" }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request rate by lane",
      "description": "Lane dispatch split (DESIGN.md §6.1). One color per lane, fixed.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "ozpx-prometheus" },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (lane) (rate(request_duration_seconds_count[1m]))",
          "legendFormat": "{{lane}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto",
            "scaleDistribution": { "type": "linear" },
            "hideFrom": { "tooltip": false, "viz": false, "legend": false },
            "thresholdsStyle": { "mode": "off" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "sigv4" },
            "properties": [
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "#3987e5" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "bearer" },
            "properties": [
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "#199e70" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "presigned" },
            "properties": [
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "#c98500" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "sts" },
            "properties": [
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "#9085e9" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "unauthenticated" },
            "properties": [
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "#e66767" }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "SigV4 verification latency",
      "description": "Pure verification step, sigv4 lane. Ordinal percentile ramp; the red line is the 1 ms SLO (DESIGN.md §11.5).",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "ozpx-prometheus" },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(verification_duration_seconds_bucket{lane=\"sigv4\"}[5m])))",
          "legendFormat": "p50",
          "range": true
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(verification_duration_seconds_bucket{lane=\"sigv4\"}[5m])))",
          "legendFormat": "p95",
          "range": true
        },
        {
          "refId": "C",
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(verification_duration_seconds_bucket{lane=\"sigv4\"}[5m])))",
          "legendFormat": "p99",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "#d03b3b", "value": 0.001 }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto",
            "scaleDistribution": { "type": "linear" },
            "hideFrom": { "tooltip": false, "viz": false, "legend": false },
            "thresholdsStyle": { "mode": "line" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p50" },
            "properties": [
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "#86b6ef" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p95" },
            "properties": [
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "#3987e5" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p99" },
            "properties": [
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "#184f95" }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "SigV4 verification outcomes",
      "description": "Data-path SigV4 results by rate. Success is green; every error result (mismatch, unknown_akid, expired, bad_token, ...) shares the critical red — the legend names which.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "ozpx-prometheus" },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (result) (rate(sigv4_verifications_total[1m]))",
          "legendFormat": "{{result}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "fixed", "fixedColor": "#d03b3b" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto",
            "scaleDistribution": { "type": "linear" },
            "hideFrom": { "tooltip": false, "viz": false, "legend": false },
            "thresholdsStyle": { "mode": "off" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "success" },
            "properties": [
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "#0ca30c" }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Upstream response codes",
      "description": "Responses from the Ozone S3 Gateway by status family (2xx good, 4xx warning, 5xx critical).",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "ozpx-prometheus" },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (code) (rate(upstream_requests_total[1m]))",
          "legendFormat": "{{code}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "fixed", "fixedColor": "#8a8a8a" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto",
            "scaleDistribution": { "type": "linear" },
            "hideFrom": { "tooltip": false, "viz": false, "legend": false },
            "thresholdsStyle": { "mode": "off" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/^2/" },
            "properties": [
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "#0ca30c" }
              }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/^4/" },
            "properties": [
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "#fab219" }
              }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/^5/" },
            "properties": [
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "#d03b3b" }
              }
            ]
          }
        ]
      }
    }
  ]
}
