# Copyright The ozone-oidc-proxy Authors
# SPDX-License-Identifier: Apache-2.0
#
# Runtime image for released binaries. goreleaser supplies the already-built
# proxy and credential portal, so nothing is compiled here; Dockerfile builds
# from source for local work.

FROM gcr.io/distroless/static-debian12:nonroot@sha256:1b7b9f0f0e0a1d2155f531db587cc48ec26aaf97ab64364225f5bf18a054e66a

# goreleaser builds this image with buildx for several platforms at once, and
# stages each platform's binaries under <os>/<arch>/ in the build context
# rather than at its root. TARGETOS and TARGETARCH are supplied by buildx, so
# one Dockerfile serves every platform.
ARG TARGETOS
ARG TARGETARCH
COPY ${TARGETOS}/${TARGETARCH}/ozone-oidc-proxy /usr/local/bin/ozone-oidc-proxy
COPY ${TARGETOS}/${TARGETARCH}/credential-portal /usr/local/bin/credential-portal

# Attribution for the Apache-2.0 components linked into these binaries,
# required by section 4(d) of that license.
COPY LICENSE /LICENSE
COPY NOTICE /NOTICE

# The gateway behind this proxy performs no authentication, so the proxy runs
# unprivileged and exposes only its data and admin ports.
USER nonroot:nonroot
EXPOSE 9000 9090

ENTRYPOINT ["/usr/local/bin/ozone-oidc-proxy"]
